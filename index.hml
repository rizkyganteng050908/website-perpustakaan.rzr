<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Perpustakaan - ASTOA</title>
    <!-- Tailwind CSS untuk Styling -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between">

    <!-- Header / Navbar -->
    <header class="bg-slate-800 border-b border-slate-700 py-4 px-6 shadow-md">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <span class="bg-blue-600 text-white font-bold px-3 py-1 rounded text-sm">ASTOA</span>
                <h1 class="text-lg font-semibold tracking-wide">SISTEM PERPUSTAKAAN</h1>
            </div>
            <div id="nav-user-info" class="hidden text-sm text-slate-300">
                Login sebagai: <span id="current-role" class="font-bold text-blue-400"></span> 
                <button onclick="logout()" class="ml-4 bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-xs transition">Logout</button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-4xl mx-auto p-6 w-full my-auto">

        <!-- 1. HALAMAN LOGIN -->
        <section id="page-login" class="bg-slate-800 border border-slate-700 rounded-xl p-8 shadow-xl max-w-md mx-auto">
            <div class="text-center mb-6">
                <h2 class="text-xl font-bold">Silkan masuk ke akun Anda</h2>
                <p class="text-xs text-slate-400 mt-1">Gunakan akun Admin atau Siswa</p>
            </div>

            <!-- Pesan Error Login -->
            <div id="login-error" class="hidden mb-4 p-3 bg-red-950 border border-red-700 text-red-300 text-sm rounded-lg flex items-center space-x-2">
                <span>⚠️ Login Gagal: Username atau Password Salah!</span>
            </div>

            <form id="form-login" onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Username / ID Anggota</label>
                    <input type="text" id="username" placeholder="Masukkan username (admin / siswa)..." required
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Password</label>
                    <input type="password" id="password" placeholder="••••••••••••" required
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-blue-500">
                </div>
                <button type="submit" class="w-full bg-blue-700 hover:bg-blue-800 text-white font-semibold py-2.5 rounded-lg transition shadow-lg text-sm tracking-wide">
                    MASUK KE SISTEM
                </button>
            </form>
            <div class="mt-4 text-center text-xs text-slate-500">
                <p>Tips Demo: Ketik username <b class="text-slate-300">admin</b> atau <b class="text-slate-300">siswa</b> dengan password bebas.</p>
            </div>
        </section>

        <!-- 2. HALAMAN DASHBOARD / KATALOG BUKU (SISWA & ADMIN) -->
        <section id="page-dashboard" class="hidden space-y-6">
            <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 shadow-xl">
                <h2 class="text-lg font-bold mb-4">Cari Katalog Buku</h2>
                <div class="flex gap-2 mb-6">
                    <input type="text" id="search-input" placeholder="Cari judul buku, pengarang, atau kategori..." 
                        class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-blue-500">
                    <button onclick="searchKatalog()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg text-sm font-semibold transition">
                        Cari Katalog
                    </button>
                </div>

                <!-- Hasil Pencarian Buku -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-slate-900 border border-slate-700 p-4 rounded-lg">
                        <h3 class="font-bold text-base">Pemrograman Web PHP & MySQL</h3>
                        <p class="text-xs text-slate-400 mt-1">Pengarang: Budi Raharjo | Kategori: Informatika</p>
                        <div class="mt-3 inline-block bg-green-950 text-green-400 border border-green-800 px-3 py-1 rounded text-xs font-semibold">
                            Stok Tersedia: 5
                        </div>
                    </div>
                    <div class="bg-slate-900 border border-slate-700 p-4 rounded-lg">
                        <h3 class="font-bold text-base">Algoritma & Struktur Data</h3>
                        <p class="text-xs text-slate-400 mt-1">Pengarang: Sutrisno | Kategori: Informatika</p>
                        <div class="mt-3 inline-block bg-red-950 text-red-400 border border-red-800 px-3 py-1 rounded text-xs font-semibold">
                            Stok Habis (0)
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kalkulator / Simulasi Form Pengembalian & Denda (Sesuai Aktivitas / Wireframe) -->
            <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 shadow-xl">
                <h2 class="text-lg font-bold mb-4">Simulasi Kalkulasi Denda Pengembalian</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1">Tanggal Jatuh Tempo</label>
                        <input type="date" id="tgl-tempo" value="2026-08-01" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1">Tanggal Dikembalikan</label>
                        <input type="date" id="tgl-kembali" value="2026-08-06" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200">
                    </div>
                </div>
                <button onclick="hitungDenda()" class="bg-slate-700 hover:bg-slate-600 text-white font-semibold px-4 py-2 rounded-lg text-sm transition mb-4">
                    Hitung Denda Otomatis
                </button>

                <!-- Hasil Kalkulasi Denda -->
                <div id="result-denda" class="hidden p-4 bg-red-950 border border-red-800 rounded-lg flex justify-between items-center">
                    <div>
                        <p class="text-sm font-bold text-red-400" id="status-terlambat">Status Keterlambatan: TERLAMBAT (5 Hari)</p>
                        <p class="text-xs text-slate-400 mt-0.5">Rumus: Selisih Hari × Tarif Denda/Hari (Rp 1.000)</p>
                    </div>
                    <div class="text-xl font-extrabold text-red-300" id="nominal-denda">Rp 5.000</div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="text-center py-4 text-xs text-slate-500 border-t border-slate-800 mt-8">
        LKPD Sistem Informasi Perpustakaan &copy; 2026 - Dewi Lusiana (XII RPL 3)
    </footer>

    <!-- JavaScript Interaktif -->
    <script>
        function handleLogin(event) {
            event.preventDefault();
            const user = document.getElementById('username').value.trim().toLowerCase();
            const pass = document.getElementById('password').value;
            const errorAlert = document.getElementById('login-error');

            // Validasi Login Sederhana
            if ((user === 'admin' || user === 'siswa') && pass !== '') {
                errorAlert.classList.add('hidden');
                document.getElementById('page-login').classList.add('hidden');
                document.getElementById('page-dashboard').classList.remove('hidden');
                document.getElementById('nav-user-info').classList.remove('hidden');
                document.getElementById('current-role').innerText = user.toUpperCase();
            } else {
                errorAlert.classList.remove('hidden');
            }
        }

        function logout() {
            document.getElementById('page-dashboard').classList.add('hidden');
            document.getElementById('nav-user-info').classList.add('hidden');
            document.getElementById('page-login').classList.remove('hidden');
            document.getElementById('username').value = '';
            document.getElementById('password').value = '';
        }

        function searchKatalog() {
            const keyword = document.getElementById('search-input').value;
            if(keyword) {
                alert('Mencari katalog buku dengan kata kunci: "' + keyword + '"');
            } else {
                alert('Silakan masukkan kata kunci pencarian terlebih dahulu!');
            }
        }

        function hitungDenda() {
            const tglTempo = new Date(document.getElementById('tgl-tempo').value);
            const tglKembali = new Date(document.getElementById('tgl-kembali').value);
            
            const selisihWaktu = tglKembali - tglTempo;
            const selisihHari = Math.ceil(selisihWaktu / (1000 * 60 * 60 * 24));
            
            const resultBox = document.getElementById('result-denda');
            const statusText = document.getElementById('status-terlambat');
            const nominalText = document.getElementById('nominal-denda');

            resultBox.classList.remove('hidden');

            if (selisihHari > 0) {
                const tarifPerHari = 1000;
                const totalDenda = selisihHari * tarifPerHari;
                statusText.innerText = `Status Keterlambatan: TERLAMBAT (${selisihHari} Hari)`;
                nominalText.innerText = `Rp ${totalDenda.toLocaleString('id-ID')}`;
            } else {
                statusText.innerText = `Status Keterlambatan: TEPAT WAKTU (Tidak ada denda)`;
                nominalText.innerText = `Rp 0`;
            }
        }
    </script>
</body>
</html>
